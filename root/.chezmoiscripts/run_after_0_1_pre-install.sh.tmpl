{{- template "bash-prefix" "run_after_0_1_pre-install" }}

{{ if eq .chezmoi.os "darwin" -}}
# Install Homebrew
if [ -x "$(command -v brew)" ]; then
  echo "[skip] Homebrew already installed"
else
  echo "-> Installing Homebrew"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  export PATH=/opt/homebrew/bin:$PATH
fi

# Install mise via Homebrew
if [ -x "$(command -v mise)" ]; then
  echo "[skip] mise already installed"
else
  echo "-> Installing mise"
  brew install mise
fi
{{ else if eq .chezmoi.os "linux" -}}
# Install build dependencies (needed for mise to compile python, etc.)
sudo apt-get -o DPkg::Lock::Timeout=60 update
sudo apt-get -o DPkg::Lock::Timeout=60 install -y \
  curl git \
  dirmngr gpg \
  unzip \
  build-essential libssl-dev zlib1g-dev libbz2-dev \
  libreadline-dev libsqlite3-dev wget llvm libncurses5-dev libncursesw5-dev \
  xz-utils tk-dev libffi-dev liblzma-dev

# Install mise via official installer
if [ -x "$(command -v mise)" ]; then
  echo "[skip] mise already installed"
else
  echo "-> Installing mise"
  curl https://mise.run | sh
  export PATH=$HOME/.local/bin:$PATH
fi
{{ end -}}
